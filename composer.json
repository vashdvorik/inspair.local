{
    "name": "workspace/laravel-copilot",
    "description": "Laravel Copilot workspace template",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "nunomaduro/larastan": "^2.9",
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.5",
        "qossmic/deptrac-shim": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php artisan test",
        "stan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "lint": "vendor/bin/pint --test",
        "lint:fix": "vendor/bin/pint",
        "check": "composer validate --no-check-all && composer dump-autoload -o && composer lint && composer stan"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
